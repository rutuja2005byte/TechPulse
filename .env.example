SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side key for the one-time source seeder only. Keep it private and out of client apps/logs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Leave false until the manual zero-cost account settings in README are verified.
TECHPULSE_FREE_TIER_CONFIRMED=true
# Optional comma-separated URLs to filter active Supabase sources.
RSS_FEED_URLS=
# Ignore articles older than this many days (default: 7).
ARTICLE_MAX_AGE_DAYS=7
# Abort a feed request after this many milliseconds (default: 15000).
RSS_FEED_TIMEOUT_MS=15000
# Gemini is used only by the server-side AI processing command.
GEMINI_API_KEY=your-gemini-api-key
# The application rejects any model override other than this configured free-tier model.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=180000
AI_MAX_ARTICLES_PER_RUN=100
AI_ARTICLES_PER_REQUEST=10
# Resend is used only by the server-side newsletter command.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=TechPulse <newsletter@your-verified-domain.example>
NEWSLETTER_RECIPIENTS=you@example.com
# Minimum global rank_score included in a newsletter (1-100; default: 70).
NEWSLETTER_MIN_IMPORTANCE_SCORE=70
