{
  "name": "techpulse-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for the TechPulse technology newsletter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "collect": "tsx src/collect.ts",
    "process:ai": "tsx src/process-ai.ts",
    "newsletter": "tsx src/newsletter.ts",
    "seed:sources": "tsx src/seed-sources.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:free-tier-guard": "node --import tsx --test src/services/free-tier-guard.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^16.6.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
